<section id="ttb-card-dock-popout" class="ttb-card-dock-popout">
    <header class="ttb-card-dock-popout__header">
        <div class="ttb-card-dock-popout__title">
            <h2>{{dock.label}}</h2>
        </div>

        <div class="ttb-card-dock-popout__controls">
            {{#each dock.controls as |control|}}
                <button
                        type="button"
                        data-action="{{control.action}}"
                        data-actor-uuid="{{control.actorUuid}}"
                        data-dock-key="{{control.dockKey}}"
                >
                    {{control.label}}
                </button>
            {{/each}}
        </div>
    </header>

    <section class="ttb-card-dock-popout__layout">
        <section class="ttb-dock-column ttb-dock-column--source">
            <div class="ttb-dock-panel">
                <div class="ttb-dock-panel__title">
                    <span>{{dock.source.title}}</span>
                    <span class="ttb-pop-badge">{{dock.source.count}}</span>
                </div>

                <div class="ttb-pop-preview ttb-pop-preview--single">
                    {{#if dock.source.hasCards}}
                        <div class="ttb-pop-card ttb-pop-card--back{{#if dock.source.hasStack}} ttb-pop-card--stacked{{/if}}">
                            <img
                                    class="ttb-pop-card__image"
                                    src="systems/through-the-breach/assets/cards/back.webp"
                                    alt="Card back"
                            />
                        </div>
                    {{else}}
                        <div class="ttb-pop-card ttb-pop-card--empty"></div>
                    {{/if}}
                </div>
            </div>
        </section>

        <section class="ttb-dock-column ttb-dock-column--active">
            <div class="ttb-dock-panel">
                <div class="ttb-dock-panel__title">
                    <span>{{dock.active.title}}</span>
                    <span class="ttb-pop-badge">{{dock.active.totalCount}}</span>
                </div>

                <div class="ttb-pop-preview ttb-pop-preview--active">
                    {{#each dock.active.visibleCards as |card|}}
                        <div class="ttb-pop-card ttb-pop-card--face" title="{{card.name}}">
                            <img
                                    class="ttb-pop-card__image"
                                    src="{{card.img}}"
                                    alt="{{card.name}}"
                            />

                            {{#if ../dock.active.actorUuid}}
                                <button
                                        type="button"
                                        class="ttb-pop-card__action"
                                        data-action="cheat-card"
                                        data-actor-uuid="{{../dock.active.actorUuid}}"
                                        data-card-id="{{card.id}}"
                                >
                                    Cheat
                                </button>
                                <button
                                        type="button"
                                        class="ttb-pop-card__action"
                                        data-action="discard-card"
                                        data-actor-uuid="{{../dock.active.actorUuid}}"
                                        data-card-id="{{card.id}}"
                                >
                                    Discard
                                </button>
                            {{/if}}
                        </div>
                    {{/each}}

                    {{#if dock.active.overflowCount}}
                        <button
                                type="button"
                                class="ttb-pop-card ttb-pop-card--overflow{{#if dock.active.showOverflowBadge}} ttb-pop-card--stacked{{/if}}"
                                data-action="open-active-overflow"
                                data-dock-key="{{dock.key}}"
                                title="Show all active cards"
                        >
                            <img
                                    class="ttb-pop-card__image"
                                    src="{{dock.active.overflowTopCard.img}}"
                                    alt="{{dock.active.overflowTopCard.name}}"
                            />

                            {{#if dock.active.showOverflowBadge}}
                                <div class="ttb-pop-card__overflow-badge">
                                    +{{dock.active.hiddenUnderTopCount}}
                                </div>
                            {{/if}}
                        </button>
                    {{/if}}
                </div>
            </div>
        </section>

        <section class="ttb-dock-column ttb-dock-column--discard">
            <div class="ttb-dock-panel">
                <div class="ttb-dock-panel__title">
                    <span>{{dock.discard.title}}</span>
                    <span class="ttb-pop-badge">{{dock.discard.count}}</span>
                </div>

                <div class="ttb-pop-preview ttb-pop-preview--single">
                    {{#if dock.discard.topCard}}
                        <div class="ttb-pop-card ttb-pop-card--face{{#if dock.discard.hasStack}} ttb-pop-card--stacked{{/if}}" title="{{dock.discard.topCard.name}}">
                            <img
                                    class="ttb-pop-card__image"
                                    src="{{dock.discard.topCard.img}}"
                                    alt="{{dock.discard.topCard.name}}"
                            />
                        </div>
                    {{else}}
                        <div class="ttb-pop-card ttb-pop-card--empty"></div>
                    {{/if}}
                </div>

                <div class="ttb-pop-actions">
                    <button
                            type="button"
                            data-action="{{dock.discard.action}}"
                            data-actor-uuid="{{dock.discard.actorUuid}}"
                    >
                        {{dock.discard.actionLabel}}
                    </button>
                </div>
            </div>
        </section>
    </section>
</section>